# Copy to .env and fill in. `make env` generates a .env with random secrets.
# Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
API_DOCS_ENABLED=true

# --- Secrets (required) -------------------------------------------------------
# At least 32 characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=idp-minio
MINIO_ROOT_PASSWORD=
# Bucket-scoped credentials the API/worker use (created by the minio-init service).
S3_APP_ACCESS_KEY=idp-app
S3_APP_SECRET_KEY=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=idp
POSTGRES_DB=idp

# --- Object storage -----------------------------------------------------------
STORAGE_BUCKET=idp-documents
# URL the *browser* uses for signed download links.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# S3_SSE=AES256

# --- Auth ---------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Ingestion ----------------------------------------------------------------
# Keep in sync with client_max_body_size in frontend/nginx.conf.
MAX_UPLOAD_BYTES=52428800

# --- Digitization ---------------------------------------------------------------
# tesseract (bundled, local) | mock (dev only, clearly labelled) | none
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng+deu

# --- Routing --------------------------------------------------------------------
# Deployment default processing policy: LOCAL_ONLY | HYBRID | CLOUD_ALLOWED.
# LOCAL_ONLY never sends document content to a cloud provider (enforced).
PROCESSING_MODE=LOCAL_ONLY
# Mock providers are refused by the router unless explicitly allowed (dev only).
ALLOW_MOCK_PROVIDERS=false

# --- LLM providers (optional) ------------------------------------------------------
# A provider is used only when configured AND its host is in LLM_ALLOWED_HOSTS.
# Providers declared local whose host is not in LLM_LOCAL_HOSTS count as cloud.
LLM_ALLOWED_HOSTS=ollama,localhost,127.0.0.1
LLM_LOCAL_HOSTS=ollama,localhost,127.0.0.1
# Local model via `docker compose --profile llm up` (pull the model first:
#   docker compose exec ollama ollama pull llama3.1:8b)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Any OpenAI-compatible endpoint (vLLM, LM Studio, a hosted API).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_LOCALITY=cloud
# Anthropic (cloud). Add api.anthropic.com to LLM_ALLOWED_HOSTS and allow cloud in the policy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Development only: labelled mock LLM that never invents values.
MOCK_LLM_ENABLED=false

# --- Enrichment -----------------------------------------------------------------
# Hosts REST connections may call (comma-separated); empty disables REST lookups.
# Connection credentials: IDP_SECRET_<NAME>=... referenced by the connection config.
ENRICHMENT_ALLOWED_HOSTS=

# --- Actions and events -------------------------------------------------------------
# Hosts webhook connections may call (comma-separated); empty disables webhooks.
# Signing secrets: IDP_SECRET_<NAME>=... referenced by the connection config.
WEBHOOK_ALLOWED_HOSTS=
# SMTP for e-mail actions (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Workers ------------------------------------------------------------------
WORKER_MAX_JOBS=4
WORKER_HEARTBEAT_SECONDS=15

# --- First tenant (created by the `bootstrap` compose service if the password is set)
IDP_BOOTSTRAP_TENANT_SLUG=demo
IDP_BOOTSTRAP_TENANT_NAME="Demo Tenant"
IDP_BOOTSTRAP_EMAIL=admin@demo.local
IDP_BOOTSTRAP_NAME="Platform Admin"
IDP_BOOTSTRAP_PASSWORD=

# --- Local development without Docker (backend/.env) --------------------------
# DATABASE_URL=postgresql+asyncpg://idp:<password>@localhost:5432/idp
# REDIS_URL=redis://localhost:6379/0
# STORAGE_BACKEND=local
# CORS_ORIGINS=http://localhost:5173
